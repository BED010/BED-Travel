<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Nomad Steppe — Agence de voyage spécialisée au Kirghizistan. Circuits authentiques, aventure nomade, lacs alpins et culture kirghize au cœur des montagnes d'Asie centrale.">
<meta name="keywords" content="Kirghizistan, voyage, circuits, aventure, nomade, Asie centrale, montagnes, Issyk-Koul">
<title>Nomad Steppe — Voyages au Kirghizistan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0d1b2e;
    --blue-deep: #1a3a5c;
    --blue-mid: #2e6b9e;
    --sky: #7eb8d4;
    --sand: #c8a96e;
    --sand-light: #e8d5a8;
    --sand-pale: #f5edd8;
    --green-mountain: #3a5c3a;
    --green-mid: #5a7a4a;
    --white: #faf8f3;
    --gold: #c8a038;
    --gold-light: #e4c06a;
    --text-dark: #1a1208;
    --text-mid: #4a3e2a;
    --transition: 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    background: var(--white);
    color: var(--text-dark);
    overflow-x: hidden;
    cursor: none;
  }

  /* ─── CUSTOM CURSOR ─── */
  .cursor {
    width: 10px; height: 10px;
    background: var(--gold);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.15s ease, width 0.3s ease, height 0.3s ease, background 0.3s ease;
    mix-blend-mode: normal;
  }
  .cursor-ring {
    width: 38px; height: 38px;
    border: 1.5px solid rgba(200, 160, 56, 0.6);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9998;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), width 0.3s ease, height 0.3s ease;
  }
  body:has(a:hover) .cursor, body:has(button:hover) .cursor { width: 6px; height: 6px; }
  body:has(a:hover) .cursor-ring, body:has(button:hover) .cursor-ring { width: 54px; height: 54px; border-color: var(--gold); }

  /* ─── HEADER ─── */
  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    padding: 24px 48px;
    display: flex; align-items: center; justify-content: space-between;
    transition: background var(--transition), padding var(--transition), backdrop-filter var(--transition);
  }
  header.scrolled {
    background: rgba(13, 27, 46, 0.92);
    backdrop-filter: blur(12px);
    padding: 16px 48px;
    border-bottom: 1px solid rgba(200, 160, 56, 0.15);
  }

  .logo {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none; color: var(--white);
  }
  .logo-mark {
    width: 42px; height: 42px;
    position: relative;
  }
  .logo-mark svg { width: 100%; height: 100%; }
  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-text span:first-child {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px; font-weight: 600; letter-spacing: 0.08em;
    color: var(--white);
  }
  .logo-text span:last-child {
    font-size: 9px; font-weight: 400; letter-spacing: 0.25em;
    color: var(--gold-light); text-transform: uppercase;
  }

  nav { display: flex; align-items: center; gap: 36px; }
  nav a {
    color: rgba(255,255,255,0.85); text-decoration: none;
    font-size: 12px; font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase;
    position: relative; transition: color 0.3s;
  }
  nav a::after {
    content: ''; position: absolute; bottom: -4px; left: 0; right: 0;
    height: 1px; background: var(--gold); transform: scaleX(0);
    transform-origin: left; transition: transform 0.3s ease;
  }
  nav a:hover { color: var(--gold-light); }
  nav a:hover::after { transform: scaleX(1); }

  .nav-cta {
    background: transparent; border: 1.5px solid var(--gold);
    color: var(--gold) !important; padding: 10px 24px;
    border-radius: 2px; letter-spacing: 0.18em;
    transition: background 0.3s, color 0.3s !important;
  }
  .nav-cta::after { display: none !important; }
  .nav-cta:hover { background: var(--gold) !important; color: var(--navy) !important; }

  /* ─── HAMBURGER ─── */
  .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; }
  .hamburger span { width: 26px; height: 1.5px; background: var(--white); transition: var(--transition); display: block; }
  .hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(4px, 5px); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(4px, -5px); }

  /* ─── HERO ─── */
  .hero {
    height: 100vh; min-height: 700px;
    position: relative; overflow: hidden;
  }

  .hero-slides { position: absolute; inset: 0; }
  .hero-slide {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    opacity: 0; transition: opacity 1.8s ease;
    transform: scale(1.06);
    animation: none;
  }
  .hero-slide.active { opacity: 1; animation: zoomIn 8s ease forwards; }
  .hero-slide.leaving { opacity: 0; }

  @keyframes zoomIn {
    from { transform: scale(1.06); }
    to { transform: scale(1.0); }
  }

  /* Slide backgrounds using gradient placeholders with SVG overlays */
  .slide-1 { background: linear-gradient(135deg, #0d2a4a 0%, #1a5078 30%, #2e8ab8 55%, #a8d4e8 75%, #f0f8ff 100%); }
  .slide-2 { background: linear-gradient(160deg, #0a1f0a 0%, #1a3a1a 25%, #2a6a3a 50%, #4a9a5a 70%, #1a5078 90%, #0d2a4a 100%); }
  .slide-3 { background: linear-gradient(140deg, #3a2a0a 0%, #8a6a2a 30%, #c8a96e 55%, #e8d5a8 75%, #f5edd8 100%); }
  .slide-4 { background: linear-gradient(150deg, #1a0a2a 0%, #2a1a5a 25%, #4a3a8a 50%, #7a6aba 70%, #c8a96e 90%); }
  .slide-5 { background: linear-gradient(130deg, #0a2a1a 0%, #1a5a3a 30%, #3a8a5a 55%, #6aba8a 75%, #c8e8d8 100%); }

  /* SVG landscape illustrations for slides */
  .slide-illustration {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0.6;
  }

  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(13, 27, 46, 0.3) 0%,
      rgba(13, 27, 46, 0.1) 40%,
      rgba(13, 27, 46, 0.5) 80%,
      rgba(13, 27, 46, 0.8) 100%
    );
    z-index: 2;
  }

  .hero-content {
    position: absolute; inset: 0; z-index: 3;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 0 24px;
  }

  .hero-eyebrow {
    font-size: 11px; font-weight: 400; letter-spacing: 0.38em;
    text-transform: uppercase; color: var(--gold-light);
    margin-bottom: 24px;
    opacity: 0; animation: fadeUp 1s 0.5s forwards;
    display: flex; align-items: center; gap: 16px;
  }
  .hero-eyebrow::before, .hero-eyebrow::after {
    content: ''; width: 40px; height: 1px; background: var(--gold-light);
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(48px, 8vw, 108px);
    font-weight: 300; line-height: 0.95;
    color: var(--white); margin-bottom: 28px;
    opacity: 0; animation: fadeUp 1s 0.8s forwards;
    letter-spacing: -0.02em;
  }
  .hero-title em { font-style: italic; color: var(--sand-light); }

  .hero-subtitle {
    font-size: clamp(13px, 1.6vw, 16px); font-weight: 300;
    color: rgba(255,255,255,0.75); letter-spacing: 0.12em;
    max-width: 560px; line-height: 1.8; margin-bottom: 48px;
    opacity: 0; animation: fadeUp 1s 1.1s forwards;
  }

  .hero-cta {
    opacity: 0; animation: fadeUp 1s 1.4s forwards;
    display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;
  }

  .btn-primary {
    background: var(--gold); color: var(--navy);
    border: none; padding: 16px 40px;
    font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 500;
    letter-spacing: 0.22em; text-transform: uppercase;
    text-decoration: none; cursor: pointer;
    transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
    position: relative; overflow: hidden;
  }
  .btn-primary::after {
    content: ''; position: absolute; inset: 0;
    background: rgba(255,255,255,0.15);
    transform: translateX(-100%); transition: transform 0.4s ease;
  }
  .btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); box-shadow: 0 12px 40px rgba(200,160,56,0.4); }
  .btn-primary:hover::after { transform: translateX(0); }

  .btn-ghost {
    background: transparent; color: var(--white);
    border: 1.5px solid rgba(255,255,255,0.5); padding: 15px 38px;
    font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 400;
    letter-spacing: 0.22em; text-transform: uppercase;
    text-decoration: none; cursor: pointer;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
  }
  .btn-ghost:hover { border-color: var(--white); background: rgba(255,255,255,0.08); }

  /* Slide indicators */
  .hero-indicators {
    position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%);
    z-index: 4; display: flex; gap: 10px;
  }
  .hero-indicator {
    width: 28px; height: 2px; background: rgba(255,255,255,0.3);
    cursor: pointer; transition: background 0.3s, width 0.3s;
  }
  .hero-indicator.active { background: var(--gold); width: 48px; }

  /* Scroll hint */
  .scroll-hint {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    z-index: 4; display: flex; flex-direction: column; align-items: center; gap: 8px;
    opacity: 0; animation: fadeIn 1s 2.2s forwards;
  }
  .scroll-hint span {
    font-size: 9px; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }
  .scroll-mouse {
    width: 22px; height: 34px; border: 1.5px solid rgba(255,255,255,0.35);
    border-radius: 11px; position: relative; display: flex; justify-content: center; padding-top: 6px;
  }
  .scroll-mouse::before {
    content: ''; width: 3px; height: 8px; background: var(--gold);
    border-radius: 2px; animation: scrollDown 2s infinite;
  }
  @keyframes scrollDown {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(10px); opacity: 0; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* ─── SECTION GENERIC ─── */
  section { position: relative; }

  .section-header {
    text-align: center; margin-bottom: 72px;
  }
  .section-tag {
    display: inline-block; font-size: 10px; font-weight: 400;
    letter-spacing: 0.35em; text-transform: uppercase; color: var(--gold);
    margin-bottom: 16px; position: relative;
  }
  .section-tag::before, .section-tag::after {
    content: '—'; margin: 0 10px; opacity: 0.6;
  }
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 64px); font-weight: 300;
    color: var(--navy); line-height: 1.1; letter-spacing: -0.01em;
  }
  .section-title em { font-style: italic; color: var(--blue-mid); }
  .section-subtitle {
    font-size: 15px; color: var(--text-mid); font-weight: 300;
    max-width: 540px; margin: 16px auto 0; line-height: 1.8;
  }

  /* ─── ABOUT STRIP ─── */
  .about-strip {
    background: var(--navy);
    padding: 80px 48px;
    display: grid; grid-template-columns: 1fr 2px 1fr 2px 1fr;
    gap: 0; align-items: center;
  }
  .strip-divider { background: rgba(200,160,56,0.25); height: 60px; justify-self: center; }
  .strip-stat { text-align: center; padding: 0 40px; }
  .strip-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 56px; font-weight: 300; color: var(--gold);
    line-height: 1; display: block;
  }
  .strip-label {
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(255,255,255,0.5); margin-top: 8px; display: block;
  }

  /* ─── VOYAGES SECTION ─── */
  .voyages {
    padding: 120px 48px;
    background: var(--white);
  }

  .voyage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 1280px; margin: 0 auto;
  }

  .voyage-card {
    position: relative; overflow: hidden;
    height: 580px; cursor: pointer;
    text-decoration: none; display: block;
    border: 1px solid rgba(200,160,56,0.12);
  }

  .voyage-card-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transition: transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .voyage-card:hover .voyage-card-bg { transform: scale(1.07); }

  .card-bg-1 { background: linear-gradient(145deg, #1a3a5c 0%, #2e6b9e 40%, #3a8a6a 70%, #4aaa6a 100%); }
  .card-bg-2 { background: linear-gradient(145deg, #0d1b2e 0%, #1a3a6c 35%, #2e7ab8 60%, #7eb8d4 100%); }
  .card-bg-3 { background: linear-gradient(145deg, #3a2a0a 0%, #7a5a1a 35%, #c8a96e 65%, #e8c88a 100%); }

  .voyage-card-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(13,27,46,0.95) 0%, rgba(13,27,46,0.4) 50%, transparent 100%);
    transition: background 0.5s ease;
  }
  .voyage-card:hover .voyage-card-overlay {
    background: linear-gradient(to top, rgba(13,27,46,0.98) 0%, rgba(13,27,46,0.6) 60%, rgba(13,27,46,0.2) 100%);
  }

  .voyage-card-content {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 40px 36px; z-index: 2;
    transform: translateY(0); transition: transform 0.5s ease;
  }

  .voyage-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px; color: var(--gold); letter-spacing: 0.25em;
    margin-bottom: 12px; display: block; font-weight: 400;
  }

  .voyage-type {
    font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(255,255,255,0.5); margin-bottom: 10px; display: block;
  }

  .voyage-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 34px; font-weight: 300; color: var(--white);
    line-height: 1.1; margin-bottom: 16px;
  }

  .voyage-desc {
    font-size: 13px; color: rgba(255,255,255,0.65); font-weight: 300;
    line-height: 1.75; margin-bottom: 28px;
    max-height: 0; overflow: hidden;
    transition: max-height 0.5s ease, opacity 0.5s ease;
    opacity: 0;
  }
  .voyage-card:hover .voyage-desc { max-height: 80px; opacity: 1; }

  .voyage-meta {
    display: flex; gap: 20px; margin-bottom: 24px;
    align-items: center;
  }
  .voyage-meta-item {
    font-size: 11px; letter-spacing: 0.12em; color: rgba(255,255,255,0.5);
    display: flex; align-items: center; gap: 6px;
  }
  .voyage-meta-item svg { width: 13px; height: 13px; opacity: 0.6; }

  .voyage-btn {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; font-weight: 400; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gold); border-bottom: 1px solid rgba(200,160,56,0.3);
    padding-bottom: 4px; transition: gap 0.3s, border-color 0.3s;
  }
  .voyage-card:hover .voyage-btn { gap: 16px; border-color: var(--gold); }
  .voyage-btn svg { width: 16px; height: 16px; transition: transform 0.3s; }
  .voyage-card:hover .voyage-btn svg { transform: translateX(4px); }

  /* Landscape SVG in cards */
  .card-landscape {
    position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.35;
  }

  /* ─── FEATURED SECTION ─── */
  .featured {
    padding: 0;
    background: var(--navy);
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 600px;
  }
  .featured-visual {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, #1a3a5c, #2e7ab8, #5aaad8);
  }
  .featured-content {
    padding: 80px 72px;
    display: flex; flex-direction: column; justify-content: center;
    position: relative;
  }
  .featured-content::before {
    content: '';
    position: absolute; top: 40px; left: 0; bottom: 40px;
    width: 1px; background: linear-gradient(to bottom, transparent, rgba(200,160,56,0.4), transparent);
  }
  .featured-tag {
    font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 24px;
  }
  .featured-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 4vw, 58px); font-weight: 300; color: var(--white);
    line-height: 1.1; margin-bottom: 24px;
  }
  .featured-title em { font-style: italic; color: var(--sand-light); }
  .featured-text {
    font-size: 14px; color: rgba(255,255,255,0.6); line-height: 1.9;
    margin-bottom: 36px; font-weight: 300;
  }
  .featured-list {
    list-style: none; margin-bottom: 48px;
  }
  .featured-list li {
    font-size: 13px; color: rgba(255,255,255,0.7); padding: 10px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    display: flex; align-items: center; gap: 12px;
  }
  .featured-list li::before {
    content: ''; width: 20px; height: 1px; background: var(--gold); flex-shrink: 0;
  }

  /* ─── GALLERY STRIP ─── */
  .gallery-strip { padding: 100px 48px; background: var(--sand-pale); }
  .gallery-mosaic {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    gap: 16px; max-width: 1280px; margin: 0 auto;
  }
  .gallery-item {
    position: relative; overflow: hidden; cursor: pointer;
  }
  .gallery-item:first-child { grid-row: 1 / 3; }
  .gallery-item-bg {
    position: absolute; inset: 0; background-size: cover; background-position: center;
    transition: transform 0.7s ease;
  }
  .gallery-item:hover .gallery-item-bg { transform: scale(1.06); }
  .gallery-item-overlay {
    position: absolute; inset: 0;
    background: rgba(13,27,46,0);
    transition: background 0.4s;
  }
  .gallery-item:hover .gallery-item-overlay { background: rgba(13,27,46,0.25); }

  /* Gallery bg gradients */
  .g-bg-1 { background: linear-gradient(145deg, #1a3a5c, #3a8ab8, #7eb8d4, #c8e8f8); }
  .g-bg-2 { background: linear-gradient(135deg, #3a5c3a, #5a8a5a, #8aba6a, #c8e8a8); }
  .g-bg-3 { background: linear-gradient(155deg, #5c3a1a, #9a6a2a, #c8a96e, #e8d5a8); }
  .g-bg-4 { background: linear-gradient(140deg, #1a1a4a, #3a3a8a, #6a6ab8, #b8b8e8); }
  .g-bg-5 { background: linear-gradient(150deg, #0a2a0a, #2a5a2a, #5a9a5a, #a8d8a8); }

  /* ─── TÉMOIGNAGES ─── */
  .testimonials {
    padding: 120px 48px; background: var(--white);
  }
  .testimonial-track {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 32px; max-width: 1100px; margin: 0 auto;
  }
  .testimonial {
    padding: 44px 36px;
    border: 1px solid rgba(200,160,56,0.18);
    position: relative; background: var(--white);
    transition: border-color 0.4s, box-shadow 0.4s, transform 0.4s;
  }
  .testimonial:hover {
    border-color: var(--gold); transform: translateY(-6px);
    box-shadow: 0 24px 60px rgba(200,160,56,0.12);
  }
  .testimonial::before {
    content: '"'; position: absolute; top: 20px; right: 28px;
    font-family: 'Cormorant Garamond', serif; font-size: 80px; color: var(--sand-light);
    line-height: 1; font-weight: 300;
  }
  .testimonial-text {
    font-family: 'Cormorant Garamond', serif; font-size: 17px;
    font-style: italic; color: var(--text-dark); line-height: 1.75;
    margin-bottom: 28px; font-weight: 400;
  }
  .testimonial-author { display: flex; align-items: center; gap: 14px; }
  .testimonial-avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--blue-mid); flex-shrink: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--white);
  }
  .testimonial-name { font-size: 13px; font-weight: 500; color: var(--navy); display: block; }
  .testimonial-meta { font-size: 11px; color: var(--text-mid); letter-spacing: 0.08em; }
  .stars { color: var(--gold); font-size: 12px; letter-spacing: 3px; margin-bottom: 16px; }

  /* ─── NEWSLETTER ─── */
  .newsletter {
    padding: 100px 48px;
    background: linear-gradient(135deg, var(--navy) 0%, var(--blue-deep) 100%);
    text-align: center; position: relative; overflow: hidden;
  }
  .newsletter::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(200,160,56,0.12) 0%, transparent 60%);
  }
  .newsletter-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 60px); font-weight: 300; color: var(--white);
    margin-bottom: 16px; position: relative;
  }
  .newsletter-sub { font-size: 15px; color: rgba(255,255,255,0.55); margin-bottom: 44px; }
  .newsletter-form {
    display: flex; gap: 0; max-width: 480px; margin: 0 auto;
    position: relative;
  }
  .newsletter-form input {
    flex: 1; padding: 18px 24px;
    background: rgba(255,255,255,0.06); border: 1.5px solid rgba(255,255,255,0.15);
    border-right: none; color: var(--white); font-family: 'Jost', sans-serif;
    font-size: 14px; outline: none;
    transition: border-color 0.3s;
  }
  .newsletter-form input::placeholder { color: rgba(255,255,255,0.35); }
  .newsletter-form input:focus { border-color: var(--gold); }
  .newsletter-form button {
    padding: 18px 28px; background: var(--gold); border: 1.5px solid var(--gold);
    color: var(--navy); font-family: 'Jost', sans-serif; font-size: 11px;
    font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase;
    cursor: pointer; transition: background 0.3s;
    white-space: nowrap;
  }
  .newsletter-form button:hover { background: var(--gold-light); }

  /* ─── FOOTER ─── */
  footer {
    background: var(--text-dark);
    padding: 80px 48px 40px;
  }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 60px; margin-bottom: 60px;
  }
  .footer-brand .logo { margin-bottom: 20px; }
  .footer-desc { font-size: 13px; color: rgba(255,255,255,0.4); line-height: 1.8; margin-bottom: 28px; }
  .social-links { display: flex; gap: 14px; }
  .social-link {
    width: 36px; height: 36px; border: 1px solid rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.5); text-decoration: none;
    transition: border-color 0.3s, color 0.3s;
    font-size: 13px;
  }
  .social-link:hover { border-color: var(--gold); color: var(--gold); }
  .footer-col h4 {
    font-size: 11px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--gold-light); margin-bottom: 20px;
  }
  .footer-links { list-style: none; }
  .footer-links li { margin-bottom: 10px; }
  .footer-links a {
    font-size: 13px; color: rgba(255,255,255,0.45); text-decoration: none;
    transition: color 0.3s; letter-spacing: 0.06em;
  }
  .footer-links a:hover { color: rgba(255,255,255,0.85); }
  .footer-contact-item { display: flex; gap: 12px; margin-bottom: 14px; align-items: flex-start; }
  .footer-contact-item svg { width: 15px; height: 15px; color: var(--gold); flex-shrink: 0; margin-top: 2px; }
  .footer-contact-item span { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.6; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 28px; display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px;
  }
  .footer-copy { font-size: 11px; color: rgba(255,255,255,0.25); letter-spacing: 0.1em; }
  .footer-legal { display: flex; gap: 24px; }
  .footer-legal a { font-size: 11px; color: rgba(255,255,255,0.25); text-decoration: none; letter-spacing: 0.1em; transition: color 0.3s; }
  .footer-legal a:hover { color: rgba(255,255,255,0.5); }

  /* ─── SCROLL ANIMATIONS ─── */
  .reveal {
    opacity: 0; transform: translateY(40px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  .reveal.visible { opacity: 1; transform: none; }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-left { opacity: 0; transform: translateX(-40px); transition: opacity 0.9s ease, transform 0.9s ease; }
  .reveal-left.visible { opacity: 1; transform: none; }
  .reveal-right { opacity: 0; transform: translateX(40px); transition: opacity 0.9s ease, transform 0.9s ease; }
  .reveal-right.visible { opacity: 1; transform: none; }

  /* ─── PAGE DETAIL OVERLAY ─── */
  .page-overlay {
    position: fixed; inset: 0; z-index: 2000;
    background: var(--white);
    transform: translateY(100%);
    transition: transform 0.8s cubic-bezier(0.76, 0, 0.24, 1);
    overflow-y: auto;
  }
  .page-overlay.open { transform: translateY(0); }
  .overlay-close {
    position: fixed; top: 32px; right: 40px; z-index: 2001;
    width: 48px; height: 48px;
    background: rgba(13,27,46,0.9); border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.4s 0.5s, background 0.3s;
    border-radius: 50%;
  }
  .overlay-close.show { opacity: 1; }
  .overlay-close:hover { background: var(--blue-deep); }
  .overlay-close svg { width: 18px; height: 18px; color: white; }

  .overlay-hero {
    height: 65vh; position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
  }
  .overlay-hero-bg {
    position: absolute; inset: 0; background-size: cover; background-position: center;
  }
  .overlay-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(13,27,46,0.9) 0%, transparent 60%);
  }
  .overlay-hero-content {
    position: relative; padding: 60px 80px; max-width: 800px;
  }
  .overlay-tag {
    font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 16px; display: block;
  }
  .overlay-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(44px, 6vw, 72px); font-weight: 300; color: var(--white);
    line-height: 1;
  }

  .overlay-body {
    max-width: 1100px; margin: 0 auto; padding: 80px 80px 120px;
  }
  .overlay-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 80px; margin-bottom: 80px; }
  .overlay-description { font-size: 16px; color: var(--text-mid); line-height: 1.9; }
  .overlay-info { }
  .info-card {
    background: var(--sand-pale); padding: 36px;
    border-left: 3px solid var(--gold); margin-bottom: 20px;
  }
  .info-card h4 { font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
  .info-card p { font-size: 15px; color: var(--navy); font-weight: 400; }
  .overlay-activities { margin-bottom: 60px; }
  .overlay-activities h3 {
    font-family: 'Cormorant Garamond', serif; font-size: 32px; color: var(--navy); margin-bottom: 28px;
  }
  .activity-list { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .activity-item {
    display: flex; gap: 14px; align-items: flex-start; padding: 20px;
    border: 1px solid rgba(200,160,56,0.18);
  }
  .activity-icon { width: 28px; height: 28px; color: var(--gold); flex-shrink: 0; }
  .activity-item span { font-size: 14px; color: var(--text-mid); line-height: 1.5; }

  .overlay-gallery { margin-bottom: 60px; }
  .overlay-gallery h3 {
    font-family: 'Cormorant Garamond', serif; font-size: 32px; color: var(--navy); margin-bottom: 28px;
  }
  .gallery-grid-overlay {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
  }
  .gallery-grid-overlay div {
    height: 200px; overflow: hidden;
  }
  .gallery-grid-overlay div > div { height: 100%; background-size: cover; background-position: center; transition: transform 0.6s ease; }
  .gallery-grid-overlay div:hover > div { transform: scale(1.06); }

  .overlay-booking {
    background: var(--navy); padding: 60px; text-align: center;
  }
  .overlay-booking h3 {
    font-family: 'Cormorant Garamond', serif; font-size: 40px; color: var(--white); margin-bottom: 12px;
  }
  .overlay-booking p { color: rgba(255,255,255,0.55); margin-bottom: 36px; }
  .price-tag {
    font-family: 'Cormorant Garamond', serif; font-size: 52px; color: var(--gold); font-weight: 300;
    display: block; margin-bottom: 8px;
  }
  .price-note { font-size: 12px; color: rgba(255,255,255,0.35); margin-bottom: 36px; display: block; }

  /* ─── MOBILE NAV ─── */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 999;
    background: rgba(13,27,46,0.98); backdrop-filter: blur(16px);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px;
    transform: translateY(-100%); transition: transform 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .mobile-menu.open { transform: translateY(0); }
  .mobile-menu a {
    font-family: 'Cormorant Garamond', serif; font-size: 42px;
    color: var(--white); text-decoration: none; font-weight: 300;
    transition: color 0.3s;
  }
  .mobile-menu a:hover { color: var(--gold); }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .voyage-grid { grid-template-columns: 1fr 1fr; }
    .voyage-card:last-child { grid-column: span 2; height: 400px; }
    .featured { grid-template-columns: 1fr; }
    .featured-visual { min-height: 400px; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
    .testimonial-track { grid-template-columns: 1fr 1fr; }
    .testimonial-track > *:last-child { display: none; }
    .about-strip { grid-template-columns: 1fr; gap: 32px; }
    .strip-divider { display: none; }
    header { padding: 20px 32px; }
    nav { display: none; }
    .hamburger { display: flex; }
  }

  @media (max-width: 768px) {
    .voyage-grid { grid-template-columns: 1fr; }
    .voyage-card:last-child { grid-column: span 1; height: 480px; }
    .voyage-card { height: 480px; }
    .voyages, .gallery-strip, .testimonials, .newsletter { padding: 80px 24px; }
    .gallery-mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .gallery-item:first-child { grid-row: auto; }
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .testimonial-track { grid-template-columns: 1fr; }
    .testimonial-track > *:last-child { display: block; }
    .overlay-body { padding: 40px 24px 80px; }
    .overlay-grid { grid-template-columns: 1fr; gap: 32px; }
    .overlay-hero-content { padding: 40px 24px; }
    .activity-list { grid-template-columns: 1fr; }
    .gallery-grid-overlay { grid-template-columns: 1fr 1fr; }
    header.scrolled { padding: 14px 24px; }
    .newsletter-form { flex-direction: column; }
    .newsletter-form input, .newsletter-form button { width: 100%; border-right: 1.5px solid rgba(255,255,255,0.15); }
    .newsletter-form input { border-bottom: none; }
    .footer-bottom { flex-direction: column; text-align: center; }
    .cursor, .cursor-ring { display: none; }
    body { cursor: auto; }
    .about-strip { padding: 60px 24px; }
  }
</style>
</head>
<body>

<!-- Custom cursor -->
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobileMenu">
  <a href="#accueil" onclick="closeMobileMenu()">Accueil</a>
  <a href="#circuits" onclick="closeMobileMenu()">Circuits</a>
  <a href="#galerie" onclick="closeMobileMenu()">Galerie</a>
  <a href="#contact" onclick="closeMobileMenu()">Contact</a>
</div>

<!-- Header -->
<header id="header">
  <a href="#" class="logo">
    <div class="logo-mark">
      <svg viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
        <polygon points="21,3 38,34 4,34" fill="none" stroke="#c8a038" stroke-width="1.5"/>
        <polygon points="21,10 32,30 10,30" fill="rgba(200,160,56,0.15)"/>
        <line x1="21" y1="3" x2="21" y2="34" stroke="rgba(200,160,56,0.4)" stroke-width="0.8"/>
        <circle cx="21" cy="21" r="2" fill="#c8a038"/>
      </svg>
    </div>
    <div class="logo-text">
      <span>Nomad Steppe</span>
      <span>Voyages au Kirghizistan</span>
    </div>
  </a>
  <nav>
    <a href="#accueil">Accueil</a>
    <a href="#circuits">Circuits</a>
    <a href="#galerie">Galerie</a>
    <a href="#temoignages">Témoignages</a>
    <a href="#contact" class="nav-cta">Contact</a>
  </nav>
  <div class="hamburger" id="hamburger" onclick="toggleMobileMenu()">
    <span></span><span></span><span></span>
  </div>
</header>

<!-- ═══════════════════════════════════════════
     HERO SECTION
═══════════════════════════════════════════ -->
<section class="hero" id="accueil">
  <div class="hero-slides" id="heroSlides">
    <!-- Slide 1: Montagnes enneigées -->
    <div class="hero-slide slide-1 active">
      <svg class="slide-illustration" viewBox="0 0 1440 900" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="sky1" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#87ceeb" stop-opacity="0.6"/><stop offset="100%" stop-color="#4a90c8" stop-opacity="0.2"/></linearGradient>
          <linearGradient id="snow1" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/><stop offset="100%" stop-color="#d0e8f0" stop-opacity="0.4"/></linearGradient>
          <linearGradient id="rock1" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#9eb8cc" stop-opacity="0.8"/><stop offset="100%" stop-color="#4a6a80" stop-opacity="0.6"/></linearGradient>
        </defs>
        <rect width="1440" height="900" fill="url(#sky1)"/>
        <!-- Far mountains -->
        <polygon points="0,600 180,180 360,350 450,220 620,400 720,160 860,320 1000,180 1150,340 1280,200 1440,380 1440,900 0,900" fill="url(#rock1)"/>
        <!-- Snow caps -->
        <polygon points="180,180 220,240 310,200 360,350 410,280 450,220 510,300 580,240 620,400 680,280 720,160 780,230 860,320 920,240 1000,180 1060,260 1150,340 1200,250 1280,200 1340,290 1440,380 1440,200 720,0 0,300" fill="url(#snow1)" opacity="0.7"/>
        <!-- Foreground hills -->
        <path d="M0,700 Q200,580 400,650 Q600,580 720,620 Q900,550 1100,630 Q1280,580 1440,640 L1440,900 L0,900Z" fill="rgba(58,92,58,0.5)"/>
        <!-- Stars/dots -->
        <circle cx="100" cy="100" r="2" fill="white" opacity="0.6"/>
        <circle cx="350" cy="60" r="1.5" fill="white" opacity="0.5"/>
        <circle cx="600" cy="80" r="2" fill="white" opacity="0.4"/>
        <circle cx="900" cy="50" r="1.5" fill="white" opacity="0.6"/>
        <circle cx="1200" cy="90" r="2" fill="white" opacity="0.5"/>
      </svg>
    </div>

    <!-- Slide 2: Lac alpin -->
    <div class="hero-slide slide-2">
      <svg class="slide-illustration" viewBox="0 0 1440 900" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="lake1" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#7eb8d4" stop-opacity="0.9"/><stop offset="100%" stop-color="#1a5078" stop-opacity="0.8"/></linearGradient>
          <linearGradient id="lakeMtn" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#2e5c7a" stop-opacity="0.9"/><stop offset="100%" stop-color="#1a3a5c" stop-opacity="0.7"/></linearGradient>
        </defs>
        <rect width="1440" height="900" fill="#0d2a4a" opacity="0.8"/>
        <!-- Mountains behind -->
        <polygon points="0,450 200,200 400,320 600,180 800,300 1000,160 1200,280 1440,350 1440,900 0,900" fill="url(#lakeMtn)"/>
        <!-- Snow -->
        <polygon points="200,200 260,260 350,220 400,320 450,260 600,180 660,240 800,300 860,220 1000,160 1060,230 1200,280 1260,210 1440,350 1440,280 720,100 0,350" fill="rgba(230,245,255,0.55)"/>
        <!-- Lake water -->
        <ellipse cx="720" cy="720" rx="700" ry="200" fill="url(#lake1)" opacity="0.85"/>
        <!-- Water reflections -->
        <line x1="400" y1="650" x2="400" y2="800" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
        <line x1="720" y1="630" x2="720" y2="810" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
        <line x1="1040" y1="650" x2="1040" y2="800" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
        <!-- Shore -->
        <path d="M0,800 Q200,740 400,760 Q600,740 720,750 Q900,730 1100,760 Q1300,740 1440,760 L1440,900 L0,900Z" fill="rgba(58,90,40,0.6)"/>
      </svg>
    </div>

    <!-- Slide 3: Yourtes -->
    <div class="hero-slide slide-3">
      <svg class="slide-illustration" viewBox="0 0 1440 900" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="steppe1" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#8aaa6a" stop-opacity="0.7"/><stop offset="100%" stop-color="#4a7a3a" stop-opacity="0.9"/></linearGradient>
          <linearGradient id="sky3" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#d4a85a" stop-opacity="0.5"/><stop offset="100%" stop-color="#e8c870" stop-opacity="0.2"/></linearGradient>
        </defs>
        <rect width="1440" height="900" fill="url(#sky3)"/>
        <!-- Rolling hills background -->
        <path d="M0,500 Q200,380 450,420 Q700,360 900,410 Q1100,350 1300,400 Q1380,380 1440,400 L1440,900 L0,900Z" fill="url(#steppe1)"/>
        <path d="M0,600 Q300,540 600,570 Q900,530 1200,560 Q1350,540 1440,555 L1440,900 L0,900Z" fill="rgba(58,90,30,0.7)"/>
        <!-- Yourte 1 -->
        <ellipse cx="480" cy="680" rx="90" ry="25" fill="rgba(200,169,110,0.6)"/>
        <path d="M390,680 Q480,580 570,680Z" fill="rgba(245,237,216,0.9)"/>
        <rect x="430" y="665" width="100" height="16" rx="2" fill="rgba(200,169,110,0.8)"/>
        <rect x="465" y="665" width="30" height="16" fill="rgba(100,70,40,0.6)"/>
        <!-- Yourte 2 (smaller) -->
        <ellipse cx="900" cy="700" rx="65" ry="18" fill="rgba(200,169,110,0.5)"/>
        <path d="M835,700 Q900,615 965,700Z" fill="rgba(245,237,216,0.85)"/>
        <rect x="860" y="687" width="80" height="14" rx="2" fill="rgba(200,169,110,0.75)"/>
        <!-- Smoke wisps -->
        <path d="M480,580 Q490,550 475,520 Q485,490 470,460" stroke="rgba(255,255,255,0.3)" stroke-width="3" fill="none" stroke-linecap="round"/>
        <!-- Sun rays -->
        <circle cx="1200" cy="180" r="80" fill="rgba(255,200,80,0.15)"/>
        <circle cx="1200" cy="180" r="50" fill="rgba(255,200,80,0.2)"/>
        <circle cx="1200" cy="180" r="25" fill="rgba(255,200,80,0.3)"/>
      </svg>
    </div>

    <!-- Slide 4: Chevaux steppes -->
    <div class="hero-slide slide-4">
      <svg class="slide-illustration" viewBox="0 0 1440 900" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="sunset1" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#8a4a9a" stop-opacity="0.5"/><stop offset="50%" stop-color="#d4803a" stop-opacity="0.4"/><stop offset="100%" stop-color="#e8c050" stop-opacity="0.3"/></linearGradient>
        </defs>
        <rect width="1440" height="900" fill="url(#sunset1)"/>
        <!-- Mountains silhouette -->
        <polygon points="0,550 150,300 350,450 550,280 750,420 950,260 1150,400 1350,300 1440,380 1440,900 0,900" fill="rgba(50,30,80,0.7)"/>
        <!-- Ground -->
        <path d="M0,700 Q360,660 720,680 Q1080,650 1440,670 L1440,900 L0,900Z" fill="rgba(40,60,20,0.8)"/>
        <!-- Horse silhouettes -->
        <g transform="translate(500,620)">
          <ellipse cx="0" cy="0" rx="55" ry="28" fill="rgba(20,10,30,0.8)"/>
          <ellipse cx="0" cy="-24" rx="16" ry="20" fill="rgba(20,10,30,0.8)"/>
          <rect x="-8" y="-44" width="6" height="24" rx="3" fill="rgba(20,10,30,0.8)"/>
          <rect x="-30" y="12" width="8" height="30" rx="4" fill="rgba(20,10,30,0.8)"/>
          <rect x="-10" y="12" width="8" height="30" rx="4" fill="rgba(20,10,30,0.8)"/>
          <rect x="10" y="12" width="8" height="30" rx="4" fill="rgba(20,10,30,0.8)"/>
          <rect x="28" y="12" width="8" height="30" rx="4" fill="rgba(20,10,30,0.8)"/>
          <path d="M50,0 Q70,-10 80,5 Q90,-5 100,10" stroke="rgba(20,10,30,0.8)" stroke-width="6" fill="none" stroke-linecap="round"/>
        </g>
        <g transform="translate(750,640) scale(0.75)">
          <ellipse cx="0" cy="0" rx="55" ry="28" fill="rgba(20,10,30,0.7)"/>
          <ellipse cx="0" cy="-24" rx="16" ry="20" fill="rgba(20,10,30,0.7)"/>
          <rect x="-8" y="-44" width="6" height="24" rx="3" fill="rgba(20,10,30,0.7)"/>
          <rect x="-30" y="12" width="8" height="30" rx="4" fill="rgba(20,10,30,0.7)"/>
