  }
};

// ─── OPEN/CLOSE VOYAGE ───
function openVoyage(type) {
  const data = voyageData[type];
  const overlay = document.getElementById('voyageOverlay');
  const closeBtn = document.getElementById('overlayClose');

  // Set hero background
  document.getElementById('overlayBg').style.background = data.bgGradient;
  document.getElementById('overlayTag').textContent = data.tag;
  document.getElementById('overlayTitle').textContent = data.title;

  // Body content
  document.getElementById('overlayDesc').innerHTML = data.description;
  document.getElementById('overlayInfo').innerHTML = data.info;
  document.getElementById('overlayPrice').textContent = data.price;

  // Activities
  document.getElementById('overlayActivities').innerHTML = data.activities.map(a => `
    <div class="activity-item">
      <span style="font-size:22px;line-height:1">${a.icon}</span>
      <span>${a.text}</span>
    </div>
  `).join('');

  // Gallery
  document.getElementById('overlayGallery').innerHTML = data.galleryColors.map(c => `
    <div><div style="background:${c};width:100%;height:100%;"></div></div>
  `).join('');

  overlay.classList.add('open');
  closeBtn.classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeVoyage() {
  document.getElementById('voyageOverlay').classList.remove('open');
  document.getElementById('overlayClose').classList.remove('show');
  document.body.style.overflow = '';
}

// Smooth scroll for anchors
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target) {
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth' });
      closeMobileMenu();
    }
  });
});
</script>

